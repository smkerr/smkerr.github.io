---
import { SITE } from '@/site.config';

const year = new Date().getFullYear();
---

<footer
  class="text-ink-soft border-line/50 mt-16 flex flex-col gap-4 border-t pt-8 text-xs sm:flex-row sm:items-center sm:justify-between sm:text-sm"
>
  <p>
    © {year} <span class="text-ink/80 font-medium">{SITE.name}</span>. Built with{' '}
    <a href="https://astro.build" class="hover:text-ink underline underline-offset-2 transition-colors">
      Astro
    </a>, based on a template by{' '}
    <a
      href="https://github.com/BracoZS/astro-starter-portfolio"
      class="hover:text-ink underline underline-offset-2 transition-colors"
    >
      BracoZS
    </a>.
  </p>

  <nav class="flex items-center gap-4" aria-label="Social">
    {
      SITE.social.map((link) => (
        <a href={link.href} class="hover:text-ink transition-colors" rel="me">
          {link.label}
        </a>
      ))
    }
    <a href="#top" class="hover:text-ink transition-colors">
      Top ↑
    </a>
  </nav>
</footer>
