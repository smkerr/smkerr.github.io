---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, date, tags } = entry.data;

const stamp = formatDate(date, 'compact');
---

<a
  href={`/work/${entry.id}`}
  class="group border-line hover:border-signal grid grid-cols-[3.5rem_1fr_auto] items-start gap-4 border-b py-5 transition-colors sm:grid-cols-[4.5rem_1fr_auto] sm:gap-6"
>
  <span class="text-ink-soft pt-1 font-mono text-xs">{stamp}</span>

  <span class="min-w-0">
    <span class="font-display text-ink group-hover:text-signal block text-lg transition-colors">
      {title}
    </span>
    <span class="text-ink-soft mt-1 block text-sm">{summary}</span>
    {
      tags.length > 0 && (
        <span class="text-ink-soft mt-2 block font-mono text-[11px]">{tags.join(' · ')}</span>
      )
    }
  </span>

  <span
    aria-hidden="true"
    class="text-ink-soft group-hover:text-signal pt-1 transition-all group-hover:translate-x-1"
  >
    →
  </span>
</a>
