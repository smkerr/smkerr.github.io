---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
---

<BaseLayout title="Contact" description={`Get in touch with ${SITE.name}.`}>
  <section>
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">Contact</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">Get in touch.</h1>

    <p class="text-ink-soft mt-6 max-w-xl">
      The fastest way to reach me is email. I'm also around on GitHub and LinkedIn.
    </p>

    <div class="border-line bg-surface mt-8 max-w-xl rounded-lg border p-6">
      <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Email</p>
      <a
        href={`mailto:${SITE.email}`}
        class="text-ink hover:text-signal mt-2 block text-lg font-medium break-all"
      >
        {SITE.email}
      </a>
    </div>

    <ul class="mt-8 flex flex-wrap gap-4">
      {
        SITE.social.map((link) => (
          <li>
            <a
              href={link.href}
              class="border-line text-ink-soft hover:border-signal hover:text-signal rounded-full border px-4 py-2 text-sm transition-colors"
              rel="me"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
