---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, url, linkLabel, repo, links = [] } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article>
    <a href="/work" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
      ← All work
    </a>

    <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">
      {title}
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-3xl">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      {
        url && (
          <Button href={url} variant="solid">
            {linkLabel ?? 'Open'} →
          </Button>
        )
      }
      {
        repo && (
          <Button href={repo} variant="ghost">
            View code →
          </Button>
        )
      }
      {
        links.map((link) => (
          <Button href={link.href} variant="ghost">
            {link.label} →
          </Button>
        ))
      }
    </div>
  </article>
</BaseLayout>
