---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto flex max-w-3xl flex-col justify-center px-6 py-24 sm:py-32">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>

    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      {SITE.role}.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/work" variant="solid">View the work →</Button>
      <Button href="/about" variant="ghost">About</Button>
      <Button href={`mailto:${SITE.email}`} variant="ghost">Get in touch</Button>
    </div>
  </section>
</BaseLayout>
