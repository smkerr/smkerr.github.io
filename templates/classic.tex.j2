((= Classic layout: EB Garamond, dates in the left margin, small-caps organizations,
    teal links, no bullet glyphs. Same content model as cv.tex.j2. =))
\documentclass[10pt,a4paper]{article}

% ---------- Page geometry ----------
\usepackage[a4paper,left=34mm,right=38mm,top=32mm,bottom=32mm,
            marginparwidth=11mm,marginparsep=4mm]{geometry}

% ---------- Font: EB Garamond (bundled), SemiBold as bold, old-style figures ----------
\usepackage{fontspec}
\setmainfont{EBGaramond_400Regular.ttf}[
  Path           = ../../fonts/,
  ItalicFont     = EBGaramond_400Regular_Italic.ttf,
  BoldFont       = EBGaramond_600SemiBold.ttf,
  BoldItalicFont = EBGaramond_600SemiBold_Italic.ttf,
  Numbers        = {Proportional,OldStyle},
  Ligatures      = TeX]
\newfontfamily\iconsolid{fa-solid-900.ttf}[Path = ../../fonts/]
\newfontfamily\iconbrands{fa-brands-400.ttf}[Path = ../../fonts/]
\usepackage{microtype}

% ---------- Colours and links ----------
\usepackage{xcolor}
\definecolor{linkteal}{HTML}{1B6A87}
\definecolor{tbdcol}{HTML}{C62828}
\usepackage[colorlinks=true,urlcolor=linkteal,linkcolor=linkteal,
            pdftitle={((( name_plain ))), ((( doc_label )))},pdfauthor={((( name_plain )))}]{hyperref}

% ---------- Headings and paragraphs ----------
\usepackage{titlesec}
\titleformat{\section}{\Large\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{15pt}{7pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\interlinepenalty=10000 \clubpenalty=10000 \widowpenalty=10000
\pagestyle{plain}

% ---------- Dates in the left margin ----------
\usepackage{marginnote}
\reversemarginpar
\renewcommand*{\marginfont}{\footnotesize}
\renewcommand*{\raggedleftmarginnote}{\raggedright}
\newcommand{\dates}[2]{\marginnote{#1\if\relax\detokenize{#2}\relax\else-\\#2\fi}}

% ---------- Building blocks ----------
\usepackage{needspace}
\newcommand{\cvsection}[1]{\needspace{9\baselineskip}\section*{#1}}
\newcommand{\tbd}[1]{{\color{tbdcol}#1}}
% Contact icon in teal, text in black: \cvicon{solid|brands}{hex codepoint}
\newcommand{\cvicon}[2]{{\color{linkteal}\csname icon#1\endcsname\symbol{"#2}}\hspace{0.35em}}
\newcommand{\sclabel}[1]{{\scshape\addfontfeatures{LetterSpace=10}#1}}
% sub-heading inside an entry (former group heading)
\newcommand{\subhead}[1]{\par\medskip\textit{#1}\par\nobreak\smallskip\nobreak}
% one former bullet point, set as its own short paragraph
((* if bullet *))
\newcommand{\point}[1]{\hangindent=1em\hangafter=1\noindent\makebox[1em][l]{((( bullet )))}#1\par\smallskip}
((* else *))
\newcommand{\point}[1]{#1\par\smallskip}
((* endif *))
% entry heading: margin dates, first line, second line
\newcommand{\entryhead}[4]{\noindent\dates{#1}{#2}#3\par\nobreak #4\par\nobreak}

\begin{document}

((* if draft *))
{\color{tbdcol}\footnotesize DRAFT: placeholders shown in red}\par\medskip
((* endif *))

% ---------- Header: name, subtitle, one or two centred contact lines ----------
\begin{center}
  {\Huge\bfseries ((( name )))}\par
((* if subtitle *))
  \medskip
  ((( subtitle )))\par
((* endif *))
  \medskip
  {\small
  ((* for line in contact_lines *))
  ((* for c in line *))
  \mbox{((* if c.icon_font *))\cvicon{((( c.icon_font )))}{((( c.icon_code )))}((* endif *))((* if c.url *))\href{((( c.url )))}{\color{black}((( c.text )))}((* else *))((( c.text )))((* endif *))}((* if not loop.last *))\hspace{1.2em}((* endif *))
  ((* endfor *))
  ((* if not loop.last *))\\[2pt]((* endif *))
  ((* endfor *))
  }\par
\end{center}

((* for s in sections *))
\cvsection{((( s.title )))}
((* if s.kind == "text" *))
((( s.text )))\par

((* elif s.kind == "entries" *))
((* for e in s.entries *))
((* set long = e.n_bullets > 5 or e.groups|length > 1 *))
((* if long *))
\par\needspace{8\baselineskip}
((* else *))
\par\needspace{4\baselineskip}\noindent\begin{minipage}[t]{\linewidth}
((* endif *))
((* if s.id == "experience" *))
\entryhead{((( e.date1 )))}{((( e.date2 )))}{\textbf{((( e.title )))}}{((* if e.org_url *))\href{((( e.org_url )))}{\textsc{((( e.org_plain )))}}((* else *))\textsc{((( e.org_plain )))}((* endif *))((* if e.location *)), ((( e.location )))((* endif *))}
((* elif s.id in ("education", "training") *))
\entryhead{((( e.date1 )))}{((( e.date2 )))}{\textbf{((( e.title )))}}{((* if e.org_url *))\href{((( e.org_url )))}{\textsc{((( e.org_plain )))}}((* else *))\textsc{((( e.org_plain )))}((* endif *))((* if e.location *)), ((( e.location )))((* endif *))}
((* else *))
\entryhead{((( e.date1 )))}{((( e.date2 )))}{\textbf{((( e.title )))}}{((( e.org )))((* if e.location *)), ((( e.location )))((* endif *))}
((* endif *))
((* if e.intro *))
\smallskip\noindent ((( e.intro )))\par
((* endif *))
((* for g in e.groups *))
((* if g.heading *))
\subhead{((( g.heading )))}
((* elif loop.first *))
\smallskip
((* endif *))
((* for b in g.bullets *))
\point{((( b )))}
((* endfor *))
((* endfor *))
((* if long *))
\par\bigskip
((* else *))
\end{minipage}\par\bigskip
((* endif *))
((* endfor *))

((* elif s.kind == "groups" *))
((* for g in s.groups *))
((* if g.heading *))
\subhead{((( g.heading )))}
((* endif *))
((* for it in g.entries_list *))
\point{((( it )))}
((* endfor *))
((* endfor *))

((* elif s.kind == "items" *))
((* for it in s.entries_list *))
\point{((( it )))}
((* endfor *))

((* elif s.kind == "rows" *))
((= Rows go in pairs, side by side, so the section can break between pairs. =))
((* for pair in s.rows|batch(2) *))
\par\needspace{5\baselineskip}\noindent
((* for row in pair *))
\begin{minipage}[t]{0.47\textwidth}\raggedright
  \sclabel{\MakeLowercase{((( row.label )))}}\par\smallskip
  ((( row.text )))\par
\end{minipage}((* if loop.first *))\hfill((* endif *))
((* endfor *))
\par\medskip
((* endfor *))

((* endif *))
((* endfor *))

\vspace{2em}
\begin{center}\footnotesize
  Last update: \today\\
  Typeset in \LaTeX
\end{center}

\end{document}
